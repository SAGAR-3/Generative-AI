# ── Required ──────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────────
# If set, OpenAI embeddings (text-embedding-3-small) are used instead of
# the local sentence-transformers model (all-MiniLM-L6-v2).
# Leave blank to avoid any OpenAI dependency.
OPENAI_API_KEY=
